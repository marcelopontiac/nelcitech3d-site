          </table>
        </div>
      </section>
    </div>

    <!-- TAB: COMMERCIAL -->
    <div class="tab-content" id="tab-commercial">
      <div class="commercial-subtabs">
        <button class="subtab-btn active" onclick="switchSubtab('suppliers')">Fornecedores</button>
        <button class="subtab-btn" onclick="switchSubtab('purchases')">Compras</button>
