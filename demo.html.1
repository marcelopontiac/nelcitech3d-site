    <!-- TAB: INVESTMENTS -->
    <div class="tab-content" id="tab-investments">
      <section class="cards">
        <div class="card card-invest-total">
          <span class="card-label">Total Investido</span>
          <span class="card-value">R$ 37.730,00</span>
        </div>
