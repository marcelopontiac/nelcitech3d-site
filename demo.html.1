      <!-- AÇÕES B3 -->
      <div class="subtab-content active" id="subtab-acoes">
        <section class="transactions-section">
          <div class="transactions-header"><h2>Ações B3</h2></div>
          <div style="overflow-x:auto">
            <table>
              <thead><tr><th>Ticker</th><th>Nome</th><th>Qtd</th><th>Preço Médio</th><th>Preço Atual</th><th>Investido</th><th>Valor Atual</th><th>Lucro/Prejuízo</th><th>Data</th></tr></thead>
              <tbody>
                <tr>
                  <td><span class="ticker-badge">PETR4</span></td>
