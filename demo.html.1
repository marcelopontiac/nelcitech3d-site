          <canvas id="monthlyChart"></canvas>
        </div>
      </section>

      <section class="transactions-section">
        <div class="transactions-header">
          <h2>Transações</h2>
        </div>
        <div style="overflow-x:auto">
          <table>
            <thead>
              <tr>
                <th>Data</th>
                <th>Descrição</th>
                <th>Categoria</th>
                <th>Tipo</th>
                <th>Valor</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>01/07/2026</td>
                <td>Salário</td>
                <td>Salário</td>
                <td><span class="type-badge type-income">Receita</span></td>
