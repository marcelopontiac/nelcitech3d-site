<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NELCi Tech 3D - Demo Finance Dashboard</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    [data-theme="dark"] {
      --bg: #0f1117;
      --bg-card: #1a1d27;
      --bg-hover: #242836;
      --border: #2a2e3a;
      --text: #e4e6f0;
      --text-muted: #8b8fa3;
      --green: #22c55e;
      --green-bg: rgba(34,197,94,0.12);
      --red: #ef4444;
      --red-bg: rgba(239,68,68,0.12);
      --blue: #3b82f6;
      --blue-bg: rgba(59,130,246,0.12);
      --purple: #a855f7;
      --purple-bg: rgba(168,85,247,0.12);
    }

    :root { --radius: 12px; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
    }

    .demo-banner {
      background: linear-gradient(135deg, #3b82f6, #8b5cf6);
      color: white;
      text-align: center;
      padding: 0.6rem 1rem;
      font-size: 0.85rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .demo-back-btn {
      background: rgba(255,255,255,0.2);
      color: white;
      text-decoration: none;
      padding: 0.35rem 0.8rem;
      border-radius: 6px;
      font-size: 0.8rem;
      font-weight: 600;
      transition: background 0.2s;
      margin-left: 0.5rem;
    }

    .demo-back-btn:hover {
      background: rgba(255,255,255,0.35);
    }

    header {
      background: var(--bg-card);
      border-bottom: 1px solid var(--border);
      padding: 0.8rem 2rem;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .header-content {
      max-width: 1400px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }

    .header-left { display: flex; align-items: center; gap: 1rem; }
    header h1 { font-size: 1.3rem; font-weight: 700; }
    .subtitle { color: var(--text-muted); font-size: 0.8rem; }

    .nav-tabs { display: flex; gap: 0.3rem; }

    .nav-btn {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      background: transparent;
      border: none;
      color: var(--text-muted);
      padding: 0.55rem 1.1rem;
      border-radius: 8px;
      font-size: 0.85rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s;
      white-space: nowrap;
    }

    .nav-btn:hover { color: var(--text); background: var(--bg-hover); }
    .nav-btn.active { color: var(--blue); background: var(--blue-bg); font-weight: 600; }

    main {
      max-width: 1400px;
      margin: 0 auto;
      padding: 1.5rem 2rem;
    }

    .tab-content { display: none; }
    .tab-content.active { display: block; }

    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      margin-bottom: 1.5rem;
    }

    .card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.2rem 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    .card-label {
      font-size: 0.8rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .card-value { font-size: 1.6rem; font-weight: 700; }

    .card-balance { border-left: 4px solid var(--blue); }
    .card-balance .card-value { color: var(--blue); }
    .card-income { border-left: 4px solid var(--green); }
    .card-income .card-value { color: var(--green); }
    .card-expense { border-left: 4px solid var(--red); }
    .card-expense .card-value { color: var(--red); }
    .card-count { border-left: 4px solid var(--purple); }
    .card-count .card-value { color: var(--purple); }
    .card-invest-total { border-left: 4px solid var(--blue); }
    .card-invest-current { border-left: 4px solid var(--purple); }
    .card-invest-profit { border-left: 4px solid var(--green); }

    .charts-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      margin-bottom: 1.5rem;
    }

    .chart-container {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.5rem;
    }

    .chart-container h3 {
      font-size: 0.95rem;
      color: var(--text-muted);
      margin-bottom: 1rem;
      font-weight: 500;
    }

    .transactions-section {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.5rem;
    }

    .transactions-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
      flex-wrap: wrap;
      gap: 0.8rem;
    }

    .transactions-header h2 { font-size: 1.1rem; font-weight: 600; }

    .transactions-actions { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; }

    table { width: 100%; border-collapse: collapse; }

    th {
      text-align: left;
      padding: 0.7rem 0.8rem;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--text-muted);
      border-bottom: 2px solid var(--border);
      font-weight: 600;
    }

    td {
      padding: 0.7rem 0.8rem;
      font-size: 0.88rem;
      border-bottom: 1px solid var(--border);
      vertical-align: middle;
    }

    tr:hover td { background: var(--bg-hover); }

    .amount-positive { color: var(--green); font-weight: 600; }
    .amount-negative { color: var(--red); font-weight: 600; }
    .amount-profit { color: var(--green); font-weight: 600; }
    .amount-loss { color: var(--red); font-weight: 600; }

    .type-badge {
      display: inline-block;
      padding: 0.2rem 0.6rem;
      border-radius: 20px;
      font-size: 0.75rem;
      font-weight: 600;
    }

    .type-income { background: var(--green-bg); color: var(--green); }
    .type-expense { background: var(--red-bg); color: var(--red); }

    .payment-badge {
      padding: 0.2rem 0.6rem;
      border-radius: 12px;
      font-size: 0.75rem;
      font-weight: 500;
      white-space: nowrap;
    }

    .pay-avista { background: rgba(34, 197, 94, 0.15); color: #22c55e; }
    .pay-aprazo { background: rgba(251, 191, 36, 0.15); color: #fbbf24; }

    .ticker-badge {
      display: inline-block;
      background: var(--blue-bg);
      color: var(--blue);
      padding: 0.15rem 0.5rem;
      border-radius: 6px;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.3px;
    }

    .commercial-subtabs {
      display: flex;
      gap: 0;
      margin-bottom: 1.5rem;
      border-bottom: 2px solid var(--border);
      background: var(--bg-card);
      border-radius: var(--radius) var(--radius) 0 0;
      padding: 0.3rem 0.3rem 0;
      border: 1px solid var(--border);
      border-bottom: none;
      overflow-x: auto;
    }

    .subtab-btn {
      background: none;
      border: none;
      color: var(--text-muted);
      padding: 0.75rem 1.4rem;
      cursor: pointer;
      font-size: 0.88rem;
      font-weight: 500;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      border-radius: var(--radius) var(--radius) 0 0;
      transition: all 0.2s;
      position: relative;
      white-space: nowrap;
    }

    .subtab-btn::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: transparent;
      transition: background 0.2s;
    }

    .subtab-btn:hover { color: var(--text); background: var(--bg-hover); }

    .subtab-btn.active { color: var(--blue); background: var(--bg); font-weight: 600; }
    .subtab-btn.active::after { background: var(--blue); }

    .subtab-content { display: none; }
    .subtab-content.active { display: block; }

    .invest-intl-subtabs {
      display: flex;
      gap: 0.4rem;
      margin-bottom: 1.5rem;
      flex-wrap: wrap;
    }

    .intl-subtab-btn {
      background: var(--bg-card);
      border: 1px solid var(--border);
      color: var(--text-muted);
      padding: 0.5rem 1rem;
      border-radius: 8px;
      font-size: 0.82rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s;
    }

    .intl-subtab-btn:hover { color: var(--text); border-color: var(--text-muted); }

    .intl-subtab-btn.active {
      color: var(--blue);
      border-color: var(--blue);
      background: var(--blue-bg);
      font-weight: 600;
    }

    .intl-content { display: none; }
    .intl-content.active { display: block; }

    .detail-header {
      background: var(--bg-hover);
      border-radius: 8px;
      padding: 1rem;
    }

    .detail-row {
      display: flex;
      justify-content: space-between;
      padding: 0.4rem 0;
      border-bottom: 1px solid var(--border);
    }

    .detail-row:last-child { border-bottom: none; }
    .detail-label { color: var(--text-muted); font-size: 0.85rem; }
    .detail-value { color: var(--text); font-size: 0.9rem; font-weight: 500; }
    .detail-total { font-size: 1.05rem; font-weight: 700; }
    .detail-positive { color: var(--green) !important; }
    .detail-negative { color: var(--red) !important; }

    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.6);
      backdrop-filter: blur(4px);
      z-index: 200;
      justify-content: center;
      align-items: center;
    }

    .modal-overlay.active { display: flex; }

    .modal {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      width: 90%;
      max-width: 500px;
      padding: 1.5rem;
      max-height: 90vh;
      overflow-y: auto;
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.2rem;
      padding-bottom: 0.8rem;
      border-bottom: 1px solid var(--border);
    }

    .modal-header h3 { font-size: 1.1rem; }

    .modal-close {
      background: none;
      border: none;
      color: var(--text-muted);
      font-size: 1.5rem;
      cursor: pointer;
    }

    .modal-close:hover { color: var(--text); }

    .btn {
      border: none;
      border-radius: 8px;
      padding: 0.5rem 1rem;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      transition: opacity 0.2s;
    }

    .btn-primary { background: var(--blue); color: white; }
    .btn-secondary { background: var(--border); color: var(--text); }

    .btn-small {
      font-size: 0.78rem;
      padding: 0.35rem 0.7rem;
      border-radius: 6px;
      white-space: nowrap;
      background: var(--bg-hover);
      color: var(--text-muted);
      border: 1px solid var(--border);
      cursor: pointer;
    }

    .btn-small:hover { color: var(--text); border-color: var(--text-muted); }

    @media (max-width: 768px) {
      main { padding: 1rem; }
      .header-content { flex-direction: column; align-items: flex-start; }
      .charts-row { grid-template-columns: 1fr; }
      .commercial-subtabs { flex-wrap: nowrap; overflow-x: auto; }
    }
  </style>
</head>
<body>
  <div class="demo-banner">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
    Modo Demo - Visualização Somente Leitura
    <a href="index.html" class="demo-back-btn">← Voltar ao Site</a>
