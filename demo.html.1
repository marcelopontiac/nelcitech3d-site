          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
          Dashboard
        </button>
        <button class="nav-btn" onclick="switchTab('commercial')">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4zM3 6h18M16 10a4 4 0 01-8 0"/></svg>
          Comercial
        </button>
        <button class="nav-btn" onclick="switchTab('investments')">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          Investimentos
        </button>
      </nav>
    </div>
  </header>

  <main>
    <!-- TAB: DASHBOARD -->
    <div class="tab-content active" id="tab-dashboard">
      <section class="cards">
        <div class="card card-balance">
          <span class="card-label">Saldo</span>
          <span class="card-value">R$ 3.780,00</span>
        </div>
